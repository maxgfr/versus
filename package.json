{
  "name": "versus",
  "private": true,
  "version": "0.2.0",
  "description": "Face-to-face mini-games for two players on one phone, plus vs-AI and peer-to-peer online play. Free, offline, installable.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:budget": "node scripts/check-budget.mjs dist",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm check:budget",
    "generate-pwa-assets": "pwa-assets-generator"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "^5.3.0",
    "chess.js": "^1.4.0",
    "matter-js": "^0.20.0",
    "qrcode-generator": "^2.0.4",
    "trystero": "^0.26.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^26.6.5",
    "@vite-pwa/assets-generator": "^2.0.0",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1"
  }
}
